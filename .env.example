# UC Traders — environment variables
# Copy to .env (local) or set as Secrets on Replit. NEVER commit a real .env.

# Port the server listens on (Replit sets this automatically)
PORT=3000

# PostgreSQL connection string (on Replit this is provided automatically
# when you add a PostgreSQL database — do NOT paste its value anywhere)
DATABASE_URL=postgres://user:password@host:5432/database

# Set to "true" when the database requires SSL (Replit PostgreSQL does)
PGSSL=true

# Secret used to sign admin login tokens — set a long random value
JWT_SECRET=change-this-to-a-long-random-secret

# Admin login (seeded by node scripts/init-db.js).
# ADMIN_PASSWORD must be the strong admin password already shared with the
# store owner in chat. Never write the password value in any file or the repo.
ADMIN_USER=admin
ADMIN_EMAIL=amcollection874@gmail.com
ADMIN_PASSWORD=

# Public payment details shown to customers (Easypaisa only)
STORE_PAYMENT_NUMBER=03097214736
STORE_PAYMENT_TITLE=Mubeen Bibi
